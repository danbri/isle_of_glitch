#!/usr/bin/env bash
# Start, stop and inspect the world server without needing to remember anything.
#
#   ./tools/world start [--beasts N] [--cells N] [--port N] ...
#   ./tools/world stop | restart | status | log
#   ./tools/world tailscale on | off
#
# See RUNNING.md. The server keeps stepping with nobody watching, which is the
# reason it exists; closing a browser tab costs nothing.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PIDFILE="$HERE/runs/world.pid"
LOGFILE="$HERE/runs/world.log"
PORT_DEFAULT=8899

mkdir -p "$HERE/runs"

port_of() {
  # Pull --port out of the recorded command line, else the default.
  local p
  p=$(grep -o -- '--port [0-9]*' "$HERE/runs/world.cmd" 2>/dev/null | tail -1 | awk '{print $2}')
  echo "${p:-$PORT_DEFAULT}"
}

running() {
  [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

cmd_start() {
  if running; then
    echo "already running (pid $(cat "$PIDFILE")); restarting instead"
    cmd_stop
  fi
  local args=("$@")
  [ ${#args[@]} -eq 0 ] && args=(--beasts 1200 --cells 12 --port "$PORT_DEFAULT")
  echo "${args[*]}" > "$HERE/runs/world.cmd"

  ( cd "$HERE" && nohup deno run -A tools/serve-world.js "${args[@]}" \
      > "$LOGFILE" 2>&1 < /dev/null & echo $! > "$PIDFILE" )

  # Wait for it to answer rather than guessing at a sleep.
  local port; port=$(port_of)
  for _ in $(seq 1 60); do
    if curl -fsS -m 2 "http://127.0.0.1:$port/status" >/dev/null 2>&1; then
      echo "up on http://127.0.0.1:$port/  (pid $(cat "$PIDFILE"))"
      cmd_status
      return 0
    fi
    sleep 1
  done
  echo "did not come up within 60s — last of the log:"
  tail -20 "$LOGFILE"
  return 1
}

cmd_stop() {
  if running; then
    local pid; pid=$(cat "$PIDFILE")
    kill "$pid" 2>/dev/null
    for _ in $(seq 1 20); do kill -0 "$pid" 2>/dev/null || break; sleep 0.5; done
    kill -9 "$pid" 2>/dev/null
    echo "stopped (pid $pid)"
  else
    echo "not running"
  fi
  rm -f "$PIDFILE"
  # Anything else squatting on the port would make the next start fail
  # confusingly, so clear it too.
  local port; port=$(port_of)
  lsof -ti:"$port" 2>/dev/null | xargs kill -9 2>/dev/null
  return 0
}

cmd_status() {
  local port; port=$(port_of)
  if ! running; then echo "server: not running"; return 1; fi
  echo "server: running (pid $(cat "$PIDFILE")) on port $port"
  # Note the quoting: inside a single-quoted shell string a backslash stays
  # literal, so escaped double quotes reach python as \" and are a syntax error.
  # Plain double quotes inside the single-quoted block are what works.
  curl -fsS -m 5 "http://127.0.0.1:$port/status" 2>/dev/null | python3 -c '
import json, sys
try:
    d = json.load(sys.stdin)
except Exception:
    print("  (no status yet)")
    raise SystemExit
print("  step {:,}   alive {}   generation {}   lineages {}".format(
    d["steps"], d["alive"], d["generation"], d["lineages"]))
print("  arena {:,} cell slots, {:,} owned by living bodies".format(
    d["cells"], d["cellsOwned"]))
print("  births {:,}   deaths {:,}   drift {}".format(
    d["births"], d["deaths"], d.get("drift")))
' 2>/dev/null || echo "  (not answering yet)"
}

cmd_tailscale() {
  local port; port=$(port_of)
  case "${1:-}" in
    on)
      # WebGPU needs a secure context, so a bare 100.x http URL will load the
      # page and then fail with no adapter. This gives it a real certificate.
      tailscale serve --bg --https=443 "http://127.0.0.1:$port" 2>&1 | grep -v '^Warning:'
      ;;
    off) tailscale serve --https=443 off 2>&1 | grep -v '^Warning:' ; echo "tailscale serve disabled" ;;
    *)   tailscale serve status 2>&1 | grep -v '^Warning:' ;;
  esac
}

case "${1:-}" in
  start)     shift; cmd_start "$@" ;;
  stop)      cmd_stop ;;
  restart)   shift; cmd_stop; cmd_start "$@" ;;
  status)    cmd_status ;;
  log)       tail -f "$LOGFILE" ;;
  tailscale) shift; cmd_tailscale "${1:-status}" ;;
  *)
    sed -n '2,9p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    echo
    cmd_status 2>/dev/null || true
    ;;
esac
