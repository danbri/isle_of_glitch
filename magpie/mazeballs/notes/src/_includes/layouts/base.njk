<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title or "mazeballs lab notes" }}</title>
<style>
  :root { --bg:#0e1116; --fg:#d7dde5; --dim:#8b97a8; --acc:#5fc9c0; --line:#232a34; }
  @media (prefers-color-scheme: light) {
    :root { --bg:#fbfbf9; --fg:#1c2530; --dim:#5d6b7c; --acc:#12766e; --line:#e2e5ea; }
  }
  body { background:var(--bg); color:var(--fg); margin:0;
         font:16px/1.65 ui-serif, Georgia, "Iowan Old Style", serif; }
  .wrap { max-width:46rem; margin:0 auto; padding:3rem 1.25rem 6rem; }
  a { color:var(--acc); }
  h1,h2,h3 { font-family:ui-sans-serif, system-ui, sans-serif; line-height:1.25; }
  h1 { font-size:1.9rem; margin:0 0 .3rem; }
  h2 { margin-top:2.4rem; border-bottom:1px solid var(--line); padding-bottom:.3rem; }
  .meta { color:var(--dim); font-family:ui-monospace, SFMono-Regular, Menlo, monospace;
          font-size:.8rem; letter-spacing:.02em; }
  code, pre { font-family:ui-monospace, SFMono-Regular, Menlo, monospace; font-size:.85em; }
  pre { background:rgba(127,127,127,.1); padding:.9rem 1rem; border-radius:6px;
        overflow-x:auto; border:1px solid var(--line); }
  table { border-collapse:collapse; width:100%; display:block; overflow-x:auto; font-size:.9rem; }
  th,td { border:1px solid var(--line); padding:.35rem .6rem; text-align:left; }
  th { background:rgba(127,127,127,.08); }
  blockquote { border-left:3px solid var(--acc); margin:1.2rem 0; padding:.2rem 0 .2rem 1rem;
               color:var(--dim); }
  /* Figures. Plots here are generated as SVG straight from the wire format
     rather than screenshotted, so they stay sharp at any width and weigh
     almost nothing. */
  img, svg.fig { max-width:100%; height:auto; display:block; border-radius:6px;
                 border:1px solid var(--line); background:#070c0b; }
  figure { margin:1.6rem 0; }
  figcaption { color:var(--dim); font-size:.82rem; margin-top:.5rem;
               font-family:ui-monospace, SFMono-Regular, Menlo, monospace; }
  .home { display:block; margin-bottom:2rem; font-family:ui-monospace,monospace; font-size:.8rem; }
  ul.index { list-style:none; padding:0; }
  ul.index li { margin:.9rem 0; }
  ul.index .meta { display:block; }
</style>
</head>
<body>
<div class="wrap">
  <a class="home" href="{{ '/' | url }}">← mazeballs lab notes</a>
  {{ content | safe }}
</div>
</body>
</html>
