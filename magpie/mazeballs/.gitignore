node_modules
*.out.json
sweep-*.json
runs/*.json
# populations/ is deliberately NOT ignored: see populations/README.md. The full
# archives are ~890K each and stay out, but the endpoint of any arm a RESEARCH.md
# section refers to should be committed, or the run is unreproducible the moment
# its container is reclaimed.
runs/*.txt
.ref/

# Browser-automation scratch from verifying world.html
.playwright-mcp/

# server runtime state
runs/world.pid
runs/world.cmd
runs/world.log
runs/*.snapshot
runs/*.ring
runs/*.jsonl

# eleventy lab notebook.
#
# `lab/` is the BUILT SITE and is deliberately NOT ignored: GitHub Pages serves
# this repo straight from `main` with no Actions, so the committed HTML is the
# deployed HTML. Ignoring it would mean publishing nothing.
notes/node_modules/
notes/_site/
runs/lineage.csv

# Archived worlds: 4.6 MB a snapshot, regenerated by any run. The MANIFESTS
# (gen-*.json) are small and are the actual record, so they are kept.
runs/archive/*.snapshot
runs/archive/*.ring
runs/archive/*.snapshot.*

.DS_Store

# Session transcripts rendered by tools/export-conversation.js. This repo
# publishes to GitHub Pages, so conversations must never be committed.
conversations/

# Preserved worlds. The rule above only covers runs/*.snapshot — the ones kept
# deliberately live in runs/keep/ and are the same 4.4MB of state, which is DATA.
runs/keep/
