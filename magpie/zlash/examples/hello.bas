10 REM Hello from 1982
20 BORDER 1: PAPER 0: INK 7: CLS
30 PRINT "HELLO WORLD"
40 FOR i=1 TO 10
50 PRINT INK i-INT(i/8)*8; "Line "; i; TAB 16; i*i
60 NEXT i
70 PLOT 0,0: DRAW 255,175
80 CIRCLE 128,88,40
90 LET a$="Spectrum": PRINT AT 20,10; a$(1 TO 4)
100 BEEP 0.2,0: BEEP 0.2,12
110 PAUSE 50
120 GOTO 30
